{
  "name": "budgets",
  "description": "Monthly spending limits used by dashboard budget utilization.",
  "fields": {
    "customer_id": {
      "type": "string",
      "ref": "customers"
    },
    "category_id": {
      "type": "string",
      "ref": "categories"
    },
    "limit_cents": {
      "type": "integer",
      "minimum": 0
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    }
  },
  "writable": true,
  "unique": []
}
