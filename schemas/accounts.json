{
  "name": "accounts",
  "description": "Currency-specific wallets. Balances change only through transfers or simulated deposits.",
  "fields": {
    "customer_id": {
      "type": "string",
      "ref": "customers"
    },
    "name": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "EUR",
        "INR"
      ]
    },
    "balance_cents": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "frozen"
      ]
    }
  },
  "writable": false,
  "unique": []
}
