{
  "name": "recurring_rules",
  "description": "Standing payment planning metadata; no scheduler executes these rules.",
  "fields": {
    "account_id": {
      "type": "string",
      "ref": "accounts"
    },
    "name": {
      "type": "string"
    },
    "amount_cents": {
      "type": "integer",
      "minimum": 0
    },
    "frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly"
      ]
    }
  },
  "writable": true,
  "unique": []
}
